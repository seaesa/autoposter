# --- AutoPoster: TikTok -> Facebook auto poster ---
# Local dev values chạy được ngay. ĐỔI các secret trước khi push repo public.

# Domain / traffic (Traefik) + environment
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME=AutoPoster
STACK_NAME=autoposter

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# SMTP (để trống cho local; mailcatcher ở :1080)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres (giá trị local dev — đổi khi deploy)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autoposter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# App behavior
POLL_INTERVAL_MINUTES=30      # scheduler bao lâu check TikTok 1 lần (chống bị chặn: nâng lên 120-240)
BACKFILL_INTERVAL_HOURS=6     # thời gian giãn giữa các bài backfill (video cũ)
MAX_ATTEMPTS=3                # số lần retry khi đăng thất bại
RUN_SCHEDULER=true            # khởi động scheduler nền cùng API
GRAPH_VERSION=v21.0           # Facebook Graph API version

# TikTok anti-ban: export cookie từ trình duyệt (Netscape format,
# vd extension "Get cookies.txt") và trỏ vào đây. Trống = không dùng cookie.
TIKTOK_COOKIES_FILE=

# Fernet key mã hóa Facebook access token.
# Sinh: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Docker images
DOCKER_IMAGE_BACKEND=backend